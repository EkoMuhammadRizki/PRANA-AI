{
  "name": "prana-ai-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Worker MQTT → Supabase untuk PRANA-AI (proses selalu hidup, BUKAN di Vercel).",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "mqtt": "5.16.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "^5.7"
  }
}
