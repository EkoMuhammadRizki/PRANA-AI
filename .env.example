# ── Client (boleh terekspos ke browser) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<your-anon-key>

# ── Server / bridge SAJA — JANGAN pernah diberi prefix NEXT_PUBLIC_ ──
# Dipakai oleh apps/bridge, bukan oleh aplikasi Next.js.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<your-service-role-key>
MQTT_URL=mqtts://<broker-host>:8883
MQTT_USERNAME=<mqtt-user>
MQTT_PASSWORD=<mqtt-password>
BRIDGE_SHARED_SECRET=<shared-secret>
